{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits", "group:monorepos", "group:recommended"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies", "renovate"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "packageRules": [
    {"matchManagers": ["npm"], "matchUpdateTypes": ["minor", "patch"], "groupName": "npm non-major"},
    {"matchManagers": ["github-actions"], "groupName": "github-actions"}
  ]
}
